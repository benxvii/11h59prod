# Clés Cloudinary (Admin API), utilisées uniquement par
# scripts/fetch-cloudinary-images.mjs pour générer public/images.json.
# Jamais exposées au client, jamais commitées (voir .gitignore).
# À récupérer sur https://console.cloudinary.com/settings/api-keys
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Accès FTP de l'hébergement Infomaniak (11h59.ch), utilisés uniquement par
# scripts/deploy-ftp.mjs pour envoyer dist/ en production.
# Jamais exposées au client, jamais commitées (voir .gitignore).
# À récupérer sur Manager Infomaniak -> Hosting -> FTP-SFTP et accès SSH
DEPLOY_FTP_HOST=
DEPLOY_FTP_USER=
DEPLOY_FTP_PASSWORD=
